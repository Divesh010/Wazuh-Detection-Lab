<!-- Custom Wazuh Detection Rules — Wazuh-Detection-Lab -->
<!-- Deploy to: /var/ossec/etc/rules/local_rules.xml on Wazuh Server -->
<!-- Restart after deploy: sudo systemctl restart wazuh-manager -->

<group name="local,">

  <!-- ============================================================ -->
  <!-- RULE 100001: SSH Brute Force (Enhanced)                      -->
  <!-- MITRE ATT&CK: T1110.001 — Brute Force: Password Guessing    -->
  <!-- ============================================================ -->
  <rule id="100001" level="14" frequency="10" timeframe="60">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SSH Brute Force Attack Detected: High-frequency failed SSH logins from $(srcip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>attack,brute_force,authentication_failed,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- RULE 100002: Unauthorized Sudo Escalation (Enhanced)         -->
  <!-- MITRE ATT&CK: T1548.003 — Sudo and Sudo Caching             -->
  <!-- ============================================================ -->
  <rule id="100002" level="12">
    <if_sid>5401</if_sid>
    <description>Privilege Escalation Attempt: Unauthorized sudo by user '$(dstuser)' — command attempted</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>attack,privilege_escalation,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- RULE 100003: Critical System File Tampering (FIM)            -->
  <!-- MITRE ATT&CK: T1565.001 — Stored Data Manipulation          -->
  <!--               T1548.003 — Privilege Escalation (via sudoers) -->
  <!-- ============================================================ -->
  <rule id="100003" level="13">
    <if_sid>550</if_sid>
    <match>/etc/passwd|/etc/shadow|/etc/sudoers</match>
    <description>CRITICAL: Sensitive system file modified — $(file). Potential persistence or privilege escalation.</description>
    <mitre>
      <id>T1565.001</id>
      <id>T1548.003</id>
    </mitre>
    <group>attack,persistence,privilege_escalation,fim,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- RULE 100004: Unexpected Binary Added to System Path          -->
  <!-- MITRE ATT&CK: T1105 — Ingress Tool Transfer                 -->
  <!-- ============================================================ -->
  <rule id="100004" level="12">
    <if_sid>554</if_sid>
    <match>/usr/bin|/usr/sbin|/bin|/sbin</match>
    <description>Suspicious file added to system binary path: $(file). Possible attacker tool drop.</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>attack,persistence,</group>
  </rule>

</group>
